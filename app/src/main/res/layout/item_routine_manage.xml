<?xml version="1.0" encoding="utf-8"?>
<!-- item_routine_manage.xml : 루틴 관리 화면 카드 (펼침/접힘) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 헤더 (항상 표시) -->
        <LinearLayout
            android:id="@+id/layoutRoutineCardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_checklist"
                    android:tint="@color/colorPrimary"
                    android:contentDescription="루틴" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvManageRoutineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/clipartkorea_medium"
                    tools:text="마감 할 일" />

                <TextView
                    android:id="@+id/tvManageRoutineMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/colorHint"
                    android:textSize="11sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    tools:text="월/수/금 · 5개 항목" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivExpandIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/colorHint"
                android:contentDescription="펼침" />

        </LinearLayout>

        <!-- 하위 항목 (펼침 시) -->
        <LinearLayout
            android:id="@+id/layoutRoutineSubItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F9FB"
            android:visibility="gone">

            <!-- 하위 항목은 Java에서 동적으로 추가 -->
            <LinearLayout
                android:id="@+id/containerSubItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 항목 추가 버튼 -->
            <LinearLayout
                android:id="@+id/layoutAddSubItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/colorPrimary"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="항목 추가" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="항목 추가"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/clipartkorea_medium" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
