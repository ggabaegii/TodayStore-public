<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/rootView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            app:title="전달사항"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/TextAppearance.Stock.Toolbar.Title"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 본문 -->
    <ScrollView
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── 상세 카드 ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 좌측 강조선 (특이사항만 표시) -->
                    <View
                        android:id="@+id/viewDetailAccentBar"
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/colorSecondary"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 유형 뱃지 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDetailTypeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/colorSecondaryContainer"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="특이사항"
                                android:textColor="@color/colorSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/clipartkorea_medium" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 제목 -->
                        <TextView
                            android:id="@+id/tvDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="7월 매장 청소 일정 안내"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium"
                            android:layout_marginBottom="14dp"
                            tools:text="7월 매장 청소 일정 안내" />

                        <!-- 구분선 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="14dp" />

                        <!-- 작성자 정보 행 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_account_circle"
                                android:tint="@color/colorHint"
                                android:contentDescription="작성자" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="작성자"
                                android:textColor="@color/colorHint"
                                android:textSize="12sp"
                                android:fontFamily="@font/clipartkorea_medium" />

                            <TextView
                                android:id="@+id/tvDetailAuthor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="홍길동"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/clipartkorea_medium"
                                tools:text="홍길동" />

                        </LinearLayout>

                        <!-- 작성 시간 행 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/colorHint"
                                android:contentDescription="작성시간" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="작성일시"
                                android:textColor="@color/colorHint"
                                android:textSize="12sp"
                                android:fontFamily="@font/clipartkorea_medium" />

                            <TextView
                                android:id="@+id/tvDetailDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="2025.01.20  09:41"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                android:fontFamily="@font/clipartkorea_medium"
                                tools:text="2025.01.20  09:41" />

                        </LinearLayout>

                        <!-- 구분선 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="20dp" />

                        <!-- 본문 내용 -->
                        <TextView
                            android:id="@+id/tvDetailContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.6"
                            android:fontFamily="@font/clipartkorea_medium"
                            tools:text="이번 주 토요일 오전 10시에 매장 전체 청소를 진행합니다.\n\n모든 직원은 청소 도구를 미리 준비해 주세요. 청소 구역은 추후 공지 예정입니다." />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── 삭제 버튼 (권한 있는 경우만 표시) ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="삭제하기"
                android:textSize="15sp"
                android:fontFamily="@font/clipartkorea_medium"
                android:textColor="@color/colorError"
                app:strokeColor="@color/colorError"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/colorError"
                app:elevation="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
