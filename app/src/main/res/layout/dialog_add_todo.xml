<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_add_todo.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDialogTask"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="할 일 내용을 입력하세요"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"
        app:boxStrokeColor="@color/selector_input_stroke"
        app:boxStrokeWidth="1.5dp"
        app:hintTextColor="@color/colorHint"
        app:counterEnabled="true"
        app:counterMaxLength="80"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:maxLength="80"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:fontFamily="@font/clipartkorea_medium"
            android:background="@null"
            android:paddingTop="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>