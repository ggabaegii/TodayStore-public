<?xml version="1.0" encoding="utf-8"?>
<!--
    selector_input_stroke.xml
    입력 필드 테두리 색상 Selector
    - focused: Primary Blue
    - error: Error Red
    - default: 연한 회색
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:color="#D32F2F" android:state_focused="false"
        android:state_enabled="true" />

    <item android:color="#1E6FD9" android:state_focused="true" />

    <item android:color="#D8DFE8" />

</selector>