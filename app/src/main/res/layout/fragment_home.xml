<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_home.xml : 홈 화면 (Welcome + 할 일 카드 + 빠른 메뉴) -->
<androidx.core.widget.NestedScrollView
    android:id="@+id/contentView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- ── Welcome 카드 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorPrimary"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tvWelcomeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="좋은 하루예요, 홍길동님 👋"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/clipartkorea_medium" />

            <TextView
                android:id="@+id/tvWelcomeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2025년 01월 20일 (월)  09:41"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/clipartkorea_medium" />

            <TextView
                android:id="@+id/tvWelcomeStore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="강남점"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/clipartkorea_medium" />

        </LinearLayout>

        <!-- ── 오늘의 할 일 카드 ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘의 할 일"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/tvTodoRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/clipartkorea_medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  ·  "
                                android:textColor="@color/colorHint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvTodoTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorHint"
                                android:textSize="12sp"
                                android:fontFamily="@font/clipartkorea_medium" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTodoPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="57% 완료"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/clipartkorea_medium" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressTodo"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="57"
                    android:progressBackgroundTint="#E8EDF3"
                    android:progressTint="@color/colorPrimary"
                    android:indeterminate="false"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnTodoShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="체크리스트 바로가기 →"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/clipartkorea_medium"
                    android:background="@color/colorPrimaryContainer"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── 빠른 메뉴 제목 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="빠른 메뉴"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/clipartkorea_medium" />

        <!-- ── 빠른 메뉴 2×2 ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp">

            <!-- 1행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- 재고 관리 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuInventory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_inventory"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="재고 관리" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="재고 관리"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium" />
                        <TextView
                            android:id="@+id/tvMenuSub1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/colorHint"
                            android:textSize="11sp"
                            android:fontFamily="@font/clipartkorea_medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 전달사항 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuAnnouncement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_announcement"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="전달사항" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="전달사항"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium" />
                        <TextView
                            android:id="@+id/tvMenuSub2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="확인 완료"
                            android:textColor="@color/colorHint"
                            android:textSize="11sp"
                            android:fontFamily="@font/clipartkorea_medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 2행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal">

                <!-- 특이사항 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuSpecial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_warning"
                            android:tint="@color/colorSecondary"
                            android:contentDescription="특이사항" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="특이사항"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium" />
                        <TextView
                            android:id="@+id/tvMenuSub3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="확인 완료"
                            android:textColor="@color/colorHint"
                            android:textSize="11sp"
                            android:fontFamily="@font/clipartkorea_medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 체크리스트 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menuChecklist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_checklist"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="체크리스트" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="체크리스트"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/clipartkorea_medium" />
                        <TextView
                            android:id="@+id/tvMenuSub4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2건 미완료"
                            android:textColor="@color/colorSecondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/clipartkorea_medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
