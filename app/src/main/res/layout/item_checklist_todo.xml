<?xml version="1.0" encoding="utf-8"?>
<!-- item_checklist_todo.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTodo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkboxTodo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            app:buttonTint="@color/selector_checkbox"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:fontFamily="@font/clipartkorea_medium"
                android:lineSpacingMultiplier="1.3"
                tools:text="매장 바닥 청소하기" />

            <!-- 완료 정보 (완료 시만 VISIBLE) -->
            <LinearLayout
                android:id="@+id/layoutDoneInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_account_circle"
                    android:tint="@color/colorHint"
                    android:contentDescription="완료자"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/tvDoneBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorHint"
                    android:textSize="11sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    tools:text="홍길동" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_dot"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/colorHint"
                    android:contentDescription="완료시간"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/tvDoneAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorHint"
                    android:textSize="11sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    tools:text="09:41" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
