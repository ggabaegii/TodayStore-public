<?xml version="1.0" encoding="utf-8"?>
<!--
    themes.xml
    매장 관리 앱 Material Design 3 테마 설정
-->
<resources>

    <!-- 기본 앱 테마 -->
    <style name="Theme.StoreManagement" parent="Theme.MaterialComponents.Light.NoActionBar">


        <!-- Primary -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>

        <!-- Error -->
        <item name="colorError">@color/colorError</item>

        <!-- Status Bar &  Nav-Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>


        <item name="colorControlNormal">@color/black</item>

        <!-- 키보드가 올라왔을 때 레이아웃 조절 (ScrollView와 함께 동작) -->
        <item name="android:windowSoftInputMode">adjustResize</item>

        <!-- TextInputLayout 스타일 -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>

    </style>

    <!-- 로그인 화면 전용 테마 -->
    <style name="Theme.StoreManagement.Login" parent="Theme.StoreManagement">
            <item name="android:statusBarColor">@android:color/transparent</item>
            <item name="android:navigationBarColor">@color/white</item>
            <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- TextInputLayout 공통 스타일 -->
    <style name="Widget.App.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.HintText</item>
    </style>

    <!-- 힌트 텍스트 스타일 -->
    <style name="TextAppearance.App.HintText"
        parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/colorHint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 툴바 타이틀 스타일 -->
    <style name="TextAppearance.Stock.Toolbar.Title"
        parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/clipartkorea_medium</item>
    </style>

    <!-- 탭 텍스트 스타일 -->
    <style name="TextAppearance.Stock.Tab"
        parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/clipartkorea_medium</item>
    </style>

    <!-- 로그인 버튼 스타일 -->
    <style name="Widget.App.Button.Login"
        parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
