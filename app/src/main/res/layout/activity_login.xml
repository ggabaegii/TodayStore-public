<?xml version="1.0" encoding="utf-8"?>
<!--
    ┌─────────────────────────────────────────────┐
    │  매장 관리 앱 - 로그인 화면                      │
    │  activity_login.xml                          │
    │  해상도: 360×640dp / Material Design 3       │
    │  플랫폼: Android Studio                       │
    └─────────────────────────────────────────────┘

    [의존성 - build.gradle에 추가 필요]
    implementation 'com.google.android.material:material:1.11.0'
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minHeight="640dp">

        <!-- ════════════════════════════════════
             상단 1/3 : 로고 영역
             ════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutLogo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="32dp">

            <!-- 로고 배경 원형 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_store"
                    android:scaleType="centerCrop"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- 앱 이름 -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="매장 관리"
                android:textColor="@color/colorPrimary"
                android:textSize="28sp"
                android:fontFamily="@font/clipartkorea_medium"
                android:letterSpacing="0.04"
                android:textStyle="bold" />

            <!-- 서브타이틀 -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="스마트한 매장 운영의 시작"
                android:textColor="#7A8CA0"
                android:textSize="13sp"
                android:fontFamily="@font/clipartkorea_medium"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <!-- ════════════════════════════════════
             중간 : 로그인 폼 카드
             ════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 폼 헤더 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로그인"
                    android:textColor="#1A2332"
                    android:textSize="18sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <!-- ── 아이디 입력 필드 ── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUserId"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="아이디를 입력하세요"
                    app:startIconDrawable="@drawable/ic_person_outline"
                    app:startIconTint="@color/colorPrimary"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/selector_input_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/colorPrimary"
                    app:errorEnabled="true"
                    app:errorTextColor="@color/colorError"
                    app:errorIconDrawable="@drawable/ic_error_outline"
                    app:counterEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUserId"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="#1A2332"
                        android:textSize="14sp"
                        android:fontFamily="@font/clipartkorea_medium"
                        android:background="@null" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 아이디 에러 메시지는 TextInputLayout errorEnabled로 처리 -->

                <!-- 16dp 간격 -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- ── 비밀번호 입력 필드 ── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="비밀번호를 입력하세요"
                    app:startIconDrawable="@drawable/ic_lock_outline"
                    app:startIconTint="@color/colorPrimary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/colorHint"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/selector_input_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/colorPrimary"
                    app:errorEnabled="true"
                    app:errorTextColor="@color/colorError"
                    app:errorIconDrawable="@drawable/ic_error_outline"
                    app:counterEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:textColor="#1A2332"
                        android:textSize="14sp"
                        android:fontFamily="@font/clipartkorea_medium"
                        android:background="@null" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 24dp 간격 -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!-- ── 로그인 버튼 (일반 상태) ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="로그인"
                    android:textSize="16sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:visibility="visible" />

                <!-- ── 로그인 버튼 (로딩 상태) ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoginLoading"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="로그인 중..."
                    app:backgroundTint="#A8C8F0"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:enabled="false"
                    android:visibility="gone" />

                <!-- 비밀번호 찾기 -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="비밀번호를 잊으셨나요?"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/clipartkorea_medium"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════
             하단 여백 (네비게이션 바 공간 + 여백)
             ════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- 회원가입 링크 -->
            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/clipartkorea_medium"
                android:text="계정이 없으신가요? 회원가입"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp" />

            <!-- 버전 정보 -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:fontFamily="@font/clipartkorea_medium" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
