<?xml version="1.0" encoding="utf-8"?>
<!--
    item_quick_menu.xml
    빠른 메뉴 그리드 아이템
    ─────────────────────────────────────
    구조:
    MaterialCardView
     └─ ConstraintLayout
         ├─ 아이콘 (원형 배경)
         ├─ 메뉴명 텍스트
         └─ 배지 (미확인 건수)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardQuickMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 아이콘 원형 배경 -->
        <FrameLayout
            android:id="@+id/frameMenuIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivMenuIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_inventory"
                android:tint="@color/colorPrimary"
                android:contentDescription="메뉴 아이콘"
                tools:src="@drawable/ic_inventory" />

        </FrameLayout>

        <!-- 배지 (미확인 건수) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSecondary"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/clipartkorea_medium"
                tools:text="3" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 메뉴명 -->
        <TextView
            android:id="@+id/tvMenuName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="재고 관리"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/clipartkorea_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameMenuIcon"
            tools:text="재고 관리" />

        <!-- 부제 (선택적) -->
        <TextView
            android:id="@+id/tvMenuSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="3건 미확인"
            android:textColor="@color/colorHint"
            android:textSize="11sp"
            android:fontFamily="@font/clipartkorea_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMenuName"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="3건 미확인" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
